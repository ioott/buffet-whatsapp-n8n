      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * \nFROM clients \nLEFT JOIN event_quotes ON clients.phone = event_quotes.client_phone \nWHERE clients.phone = '{{ $json.phone }}' \nORDER BY event_quotes.id DESC \nLIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        32,
        -64
      ],
      "id": "[HIDDEN]",
      "name": "DB-Get-Client-Profile",
      "alwaysOutputData": true,
